# ─── Firebase Auth (server) ────────────────────────────────────
# Get this from Firebase Console → Project Settings → General → Web API Key
# Copy to server/.env
FIREBASE_WEB_API_KEY=your-firebase-web-api-key-here

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-random-secret
ADMIN_EMAIL=admin@example.com

# ─── Firebase Service Account (for Vercel / serverless) ──────
# Base64-encoded contents of server/service-account.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("server\service-account.json"))
#   Linux/macOS: base64 -w0 server/service-account.json | pbcopy
FIREBASE_SERVICE_ACCOUNT=
